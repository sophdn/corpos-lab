#!/usr/bin/env bash
# Corp-OS pre-commit hook. Wired via: git config core.hooksPath .githooks
# Delegates to the single gate entrypoint so the hook and CI run identical checks.
ROOT="$(git rev-parse --show-toplevel)"
# Worktree discipline: refuse a commit on a non-main branch in the MAIN checkout
# (linked worktrees are detected + skipped). See skill: worktree-workflow.
"$ROOT/scripts/guard-worktree-discipline.sh"
exec "$ROOT/scripts/gate.sh"
