#!/usr/bin/env bash
# corpos-lab pre-push hook. Wired via: git config core.hooksPath .githooks
#
# Runs the SLOW gate tier via corpos-gate (chain-434 dogfood cutover). Because
# tiers are a strict superset (pre-push ⊃ pre-commit), this re-runs the fast
# checks (format/vet/lint/build) AND adds the slow ones:
#   - test     : go test -race ./...            (gate.sh stage 6a)
#   - coverage : 95% floor over ./internal/...  (gate.sh stage 6b)
#   - vuln     : govulncheck v1.3.0 ./...        (gate.sh stage 4)
#
# (No image stage: assay-container builds are not part of this gate — see
# scripts/build-lab-images.sh, which runs standalone/CI.)
# Bypass the whole hook with: git push --no-verify
set -euo pipefail

# bug 1359: a delete-only push introduces no commits, so there is nothing for
# the gate to validate — and running it blocks deleting a merged branch while
# the tree carries an unrelated advisory. git feeds one "<local ref> <local
# sha> <remote ref> <remote sha>" line per pushed ref on stdin; a deletion has
# an all-zeros local sha. Skip only when EVERY pushed ref is a deletion; a push
# that introduces or moves any ref (including a mixed push) still runs the gate.
delete_only=1
saw_ref=0
while read -r _ local_sha _; do
  saw_ref=1
  case "$local_sha" in
    *[!0]*) delete_only=0 ;;
  esac
done
if [ "$saw_ref" -eq 1 ] && [ "$delete_only" -eq 1 ]; then
  echo "pre-push: delete-only push — skipping the gate (no commits to validate)."
  exit 0
fi

# bug 1370: refuse a DIRECT push of commits to the public GitHub mirror. The ONLY
# sanctioned path to the mirror is the CI mirror-publish job, which force-pushes a
# SCRUBBED, squashed snapshot of main (scripts/publish-public.sh + the fail-closed
# .pii-denylist). A developer/agent `git push github <branch>` bypasses the scrub
# entirely and is exactly how the full private CLAUDE.md reached three public branches.
# The CI runner publishes with --no-verify (it does not run this hook), so this guard
# never blocks the sanctioned publish; a delete-only mirror push already exited above.
# git passes "<remote-name> <remote-url>" as $1 $2.
remote_url="${2:-}"
case "$remote_url" in
  *github.com[:/]*)
    echo "pre-push: REFUSED — direct push to the public GitHub mirror ($remote_url)." >&2
    echo "          The mirror is published ONLY by the CI mirror-publish job, which" >&2
    echo "          force-pushes a SCRUBBED snapshot of main. A raw branch push bypasses" >&2
    echo "          the scrub and leaks private infra (bug 1370). Push to origin (gitea)" >&2
    echo "          instead; the CI job mirrors main. A branch DELETE on the mirror is" >&2
    echo "          still allowed." >&2
    exit 1
    ;;
esac

# corpos-gate is installed to ~/go/bin (via `make -C go corpos-gate-install`
# from the the private toolkit service checkout); add it to PATH so the hook fires under a
# bare git environment.
export PATH="$PATH:$HOME/go/bin"
if ! command -v corpos-gate >/dev/null 2>&1; then
  echo "pre-push: corpos-gate not found on PATH." >&2
  echo "          install it from the the private toolkit service checkout: make -C go corpos-gate-install" >&2
  echo "          or bypass with: git push --no-verify" >&2
  exit 1
fi

exec corpos-gate run --tier=pre-push
