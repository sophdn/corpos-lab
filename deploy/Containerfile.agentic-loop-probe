# Agentic-loop-probe assay variant.
#
# The assay logic (loop, sandbox, tool parsing, prompt assembly, capture) is
# compiled into the shared lab-assay binary in the base image and dispatched on
# study.json's `assay` field, so this variant image differs only in its identity
# (LAB_IMAGE) and its default run mode. It pins its own content digest, which a
# study record references, and keeps the setup-vs-agentic-loop runs distinct in
# provenance from the single-turn grounded-glyph-probe runs.
#
# Chain 550 (setup-completion-vs-agentic-loop): the harness arm.

FROM lab-base:dev

ENV LAB_IMAGE=lab-agentic-loop-probe

# Run the assay by default (base defaults to report for smoke-testing).
CMD ["run"]
