# Grounded-glyph-probe assay variant.
#
# The assay logic (prompt assembly, probe, scoring) is compiled into the shared
# lab-assay binary in the base image and dispatched on study.json's `assay`
# field, so a variant image differs only in its identity (LAB_IMAGE) and its
# default run mode. Per-variant images still earn their keep: each pins a
# distinct content digest a study record references, and future variants can
# add assay-specific runtime deps here without bloating the others.
#
# Matches the typed runner ported from
# lab-app/crates/lab-app-server/src/studies/grounded_glyph_probe.rs.

FROM lab-base:dev

ENV LAB_IMAGE=lab-grounded-glyph-probe

# Run the assay by default (base defaults to report for smoke-testing).
CMD ["run"]
